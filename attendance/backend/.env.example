# ============================================================
# Attendance System - Backend Configuration
# Copy to .env and fill in values
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# IBM i Connection (set USE_MOCK=false for real IBM i connection)
USE_MOCK=true

# IBM i ODBC connection string
# Install IBM i Access Client Solutions ODBC driver first:
#   https://www.ibm.com/support/pages/ibm-i-access-client-solutions
IBMI_HOST=your-ibmi-host.example.com
IBMI_USER=QSECOFR
IBMI_PASSWORD=your-password
IBMI_LIBRARY=ATTNDLIB
IBMI_DSN=IBMI_DSN

# Alternative: IBM i REST endpoint (if using IWS)
# IBMI_REST_BASE=http://your-ibmi-host:10080/web/services
# IBMI_REST_USER=QSECOFR
# IBMI_REST_PASS=your-password
